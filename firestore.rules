rules_version = '2';
// 21.356: bảng xếp hạng GờTa Việt. scores/{uid} = kỷ lục mét xa nhất của mỗi tài khoản.
// Ai cũng đọc được (bảng chung); chỉ chủ tài khoản ghi được tài liệu của mình, kỷ lục không được giảm.
// 21.378: trang quản trị /admin + nhật ký chơi.
//   plays/{id} = một lần vào chơi {uid, start, end, seconds} — chủ tài khoản tạo khi mở game, cập nhật seconds/end mỗi 30 s.
//   21.396: thêm practice = số giây trong đó ở chế độ TẬP LUYỆN (tùy chọn, ≤ seconds, không giảm) — bản game cũ không gửi vẫn hợp lệ.
//   runs/{id}  = điểm từng lượt {uid, metres, at} — chủ tài khoản tạo khi hết lượt.
//   admins/{uid} = danh sách quản trị viên. Trang quản trị đọc/sửa/xóa qua Cloud Function adminApi (Admin SDK, bỏ qua luật),
//   nên ở đây plays/runs/admins không cho máy khách đọc; quản trị viên vẫn được đọc/sửa trực tiếp cho tiện kiểm tra.
service cloud.firestore {
  match /databases/{database}/documents {
    match /scores/{uid} {
      allow read: if true;
      allow create: if signedInAs(uid) && valid(request.resource.data);
      allow update: if signedInAs(uid) && valid(request.resource.data)
                    && request.resource.data.best >= resource.data.best
                    && request.resource.data.runs >= resource.data.runs;
      allow delete: if signedInAs(uid) || isAdmin();
    }
    match /plays/{id} {
      allow read: if isAdmin();
      allow create: if signedInAs(request.resource.data.uid)
                    && request.resource.data.keys().hasOnly(['uid', 'start', 'end', 'seconds', 'practice'])
                    && request.resource.data.start == request.time
                    && request.resource.data.end == request.time
                    && request.resource.data.seconds == 0
                    && request.resource.data.get('practice', 0) == 0;
      allow update: if signedInAs(resource.data.uid)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['end', 'seconds', 'practice'])
                    && request.resource.data.end == request.time
                    && request.resource.data.seconds is int
                    && request.resource.data.seconds >= resource.data.seconds
                    && request.resource.data.seconds <= (request.time.toMillis() - resource.data.start.toMillis()) / 1000 + 60
                    && request.resource.data.get('practice', 0) is int
                    && request.resource.data.get('practice', 0) >= resource.data.get('practice', 0)
                    && request.resource.data.get('practice', 0) <= request.resource.data.seconds;
      allow delete: if isAdmin();
    }
    match /runs/{id} {
      allow read: if isAdmin();
      allow create: if signedInAs(request.resource.data.uid)
                    && request.resource.data.keys().hasOnly(['uid', 'metres', 'at'])
                    && request.resource.data.metres is int
                    && request.resource.data.metres >= 0 && request.resource.data.metres <= 2000000
                    && request.resource.data.at == request.time;
      allow delete: if isAdmin();
    }
    match /admins/{uid} {
      allow read: if signedInAs(uid);
    }
    function signedInAs(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function valid(d) {
      return d.keys().hasOnly(['name', 'best', 'runs', 'updatedAt'])
          && d.name is string && d.name.size() >= 1 && d.name.size() <= 24
          && d.best is int && d.best >= 0 && d.best <= 2000000
          && d.runs is int && d.runs >= 0
          && d.updatedAt == request.time;
    }
  }
}
